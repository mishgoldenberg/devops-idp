{
  "name": "devops-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "DevOps Control Center (FastAPI + HTMX)",
  "scripts": {
    "dev": "docker compose up -d postgres redis api-gateway",
    "build": "docker compose build",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "setup": "bash setup.sh",
    "restart": "bash restart.sh",
    "migrate": "node scripts/db.js migrate",
    "seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset"
  }
}