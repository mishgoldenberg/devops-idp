# Environment Configuration Template
# Copy this file to .env and fill in your values.
# Production values should come from a secret store and never be committed.

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=*

# ============================================
# ADMIN BOOTSTRAP
# ============================================
# Used only when no admin user exists in the database
HUB_ADMIN_USERNAME=admin@example.com
HUB_ADMIN_PASSWORD=change_me_in_production

# ============================================
# AUTHENTICATION
# ============================================
# HS256 signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_32_character_string
JWT_EXPIRY=8h

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devops_control_center
POSTGRES_USER=devops
# Change this in production — use a strong random password
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# REDIS (Cache)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
# Omit or leave empty if Redis has no auth
REDIS_PASSWORD=change_me_in_production

# ============================================
# AZURE DEVOPS INTEGRATION
# ============================================
# Full organization URL: https://dev.azure.com/<your-org>
AZURE_DEVOPS_BASE_URL=https://dev.azure.com/your-org
# PAT scopes needed: Project & Team (Read/Write), Process (Read/Write), Build (Read)
AZURE_DEVOPS_ADMIN_PAT=your_azure_devops_admin_personal_access_token

# ============================================
# SERVICENOW INTEGRATION
# ============================================
SNOW_BASE_URL=https://your-instance.service-now.com
SNOW_API_USERNAME=your_servicenow_service_account
SNOW_API_PASSWORD=your_servicenow_password

# ============================================
# SONARQUBE INTEGRATION
# ============================================
SONARQUBE_BASE_URL=https://your-sonarqube.example.com

# ============================================
# ARTIFACTORY INTEGRATION
# ============================================
ARTIFACTORY_BASE_URL=https://your-artifactory.example.com

# ============================================
# CONFLUENCE INTEGRATION
# ============================================
CONFLUENCE_BASE_URL=https://your-confluence.example.com

# ============================================
# TERRAFORM RUNNER (Kubernetes self-service project provisioning)
# ============================================
# GCS bucket for Terraform state and job logs
TF_GCS_BUCKET=your-tfstate-bucket
# GCP service account email used for Workload Identity (annotated on the K8s SA)
TF_GCP_SERVICE_ACCOUNT=terraform-sa@your-project.iam.gserviceaccount.com
# Kubernetes namespace where Terraform Jobs are created
TF_K8S_NAMESPACE=devops-hub
# Name of the Kubernetes ServiceAccount used by Terraform Jobs
TF_K8S_SERVICE_ACCOUNT=devops-terraform-sa

# ============================================
# VAULT (Optional secret store)
# ============================================
USE_VAULT=false
VAULT_ADDR=https://your-vault.example.com
VAULT_TOKEN=your_vault_token
VAULT_PATH=secret/devops-hub

# ============================================
# SAFE MODE
# ============================================
# When true, simulates write actions without side effects
SAFE_MODE=false
