# Copy to .env and fill in values from your deployment secret store.
#
# In the cluster these come from the `all-secrets` Kubernetes Secret and the
# `infra-config` ConfigMap, not from this file — this is for local development and
# for reading what the backend expects. `docs/env.md` lists EVERY variable the code
# reads, generated from the source by `python scripts/gen_docs.py`.

# ── Core (the backend refuses to be useful without these) ───────────────────
DATABASE_URL=postgresql://devops:devops@localhost:5432/devops_control_center
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty means no AUTH on the cache. The chart only enables `requirepass` when this
# is set — see docs/RED_TEAM_BRIEF.md §6.
REDIS_PASSWORD=

# How long a session cookie stays valid. Accepts 8h / 30m / 3600.
JWT_EXPIRY=8h

# Turns every self-service action into a simulated success, portal-wide. Also
# toggleable at runtime by an admin, which is the copy that actually matters.
SAFE_MODE=false

# Certificate verification for OUTBOUND integration calls. The pipeline currently
# deploys with this false because the internal CA is not in the image. Setting it
# true is the correct end state.
INTEGRATION_TLS_VERIFY=true

# Admin (the local Platform Admin sign-in)
HUB_ADMIN_USERNAME=
HUB_ADMIN_PASSWORD=

# Optional second LOCAL account, always a regular user — for checking the portal from a
# normal user's point of view without borrowing someone's SSO login. Leave both empty
# and no such account exists. The username MUST differ from HUB_ADMIN_USERNAME.
# Both local passwords should be at least 14 characters; the backend logs an ERROR at
# startup if either is short, well-known, or shared between the two accounts.
HUB_USER_USERNAME=
HUB_USER_PASSWORD=

# Local sign-in brute-force guard. After LOGIN_MAX_FAILURES wrong passwords against one
# account (or from one address), local sign-in is refused for LOGIN_LOCKOUT_SECONDS.
# SSO is unaffected. Defaults: 5 attempts, 900 seconds.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# How long a pod may reuse a cached "is this account still active?" answer, in
# seconds. Deactivating a user is enforced on every request, not only at sign-in, so
# this is the worst-case delay before someone already signed in is locked out.
# Default 30. Lower costs one small query per request per user; higher is cheaper.
AUTH_ACTIVE_CHECK_TTL=30

# Auth
JWT_SECRET=

# Azure DevOps
AZURE_DEVOPS_BASE_URL=
AZURE_DEVOPS_ADMIN_PAT=
# NetBIOS/AD domain used to build DOMAIN\user when granting the chosen admin on a
# newly provisioned project (e.g. CONTOSO). Leave empty to use whatever principal the
# requester types. In the pipeline, define ADO_NETBIOS_DOMAIN as a variable (empty is
# fine) so the macro is never passed through unexpanded.
ADO_NETBIOS_DOMAIN=
# The collection a self-service request targets unless the requester picks another,
# and the one its name-availability check runs against. Must be one of
# ADO_PROVISION_COLLECTIONS. Defaults to the first entry in that list.
ADO_DEFAULT_COLLECTION=DevCollection-Inheritance
# Work-item states that mean "somebody has to look at this", used by the "Needs you"
# strip. Process templates name it differently and an inherited process can invent its
# own, so this is a comma-separated list; a state that does not exist simply never
# matches. Leave unset for the default list.
ADO_REVIEW_STATES=
# Reference name of an explicit reviewer field, if the process has one (e.g.
# Custom.Reviewer). Matched IN ADDITION to System.AssignedTo. Leave EMPTY unless the
# field really exists — naming a field that does not makes the whole WIQL query fail.
ADO_REVIEWER_FIELD=

# ServiceNow
SNOW_BASE_URL=
SNOW_API_USERNAME=
SNOW_API_PASSWORD=

# Artifactory
ARTIFACTORY_BASE_URL=

# ── Database backups ────────────────────────────────────────────────────────
# Pipeline variables only — the backend never reads these. They configure the
# nightly pg_dump CronJob and the weekly restore test (docs/RUNBOOK.md §6).
#
# The DESTINATION is ARTIFACTORY_BASE_URL above: the same host the portal's
# Artifactory widgets and the image cleaner already use. The repository name is a
# chart value (infrastructure.postgres.backup.artifactory.repo, default
# devops-hub-backups), not a variable — so these two credentials are the only
# thing to add.
#
# Both must be set, or backups are switched OFF for the deploy with a warning in
# the pipeline log and "no backup has ever run" on the Platform Managing page.
# The account needs READ, DEPLOY and DELETE on that GENERIC repository — read is
# what lists the dumps to prune, delete is what removes them — and should not be
# the read-only account the portal's Artifactory widgets use.
ARTIFACTORY_BACKUP_USERNAME=
ARTIFACTORY_BACKUP_TOKEN=

# SonarQube
SONARQUBE_BASE_URL=

# Confluence
CONFLUENCE_BASE_URL=

# ── Operational limits ──────────────────────────────────────────────────────
# Connection pool. The REAL total is DB_POOL_MAX x backend replicas, so this has to
# stay comfortably under the Postgres max_connections (the chart sets 200). Running
# out is not a slowdown: every pod fails to connect at once.
DB_POOL_MIN=2
DB_POOL_MAX=8
# Explicit connect timeout on the DSN. Without one, an unreachable database makes a
# request hang for the OS default rather than failing in five seconds.
DB_CONNECT_TIMEOUT=5
# After a failed pool construction, fail fast for this many seconds instead of
# letting every request queue behind the next attempt while it holds the pool lock.
DB_POOL_RETRY_COOLDOWN=5

# The portal warns in its own log when the database passes DB_SIZE_WARN_MB, because a
# StatefulSet volume cannot be enlarged by redeploying (docs/RUNBOOK.md §5) — running
# out of space has to be seen coming. DB_VOLUME_MB is only used to phrase the warning.
DB_SIZE_WARN_MB=600
DB_VOLUME_MB=1024

# How long a decoded session token may be trusted before the account's is_active flag
# is re-read from the database. Deactivation is enforced where the token is READ, so
# this is the maximum time a disabled account keeps working.
AUTH_ACTIVE_CHECK_TTL=30

# Local sign-in lockout (also documented above): failures are counted per account AND
# per X-Forwarded-For address.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
