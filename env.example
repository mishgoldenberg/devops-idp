# Environment Configuration Template
# Copy this to .env and update with your values

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# DATABASE
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devops_control_center
POSTGRES_USER=devops
POSTGRES_PASSWORD=Devops4ever

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Devops4ever

# ============================================
# API GATEWAY
# ============================================
API_GATEWAY_PORT=8000
API_GATEWAY_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Session
SESSION_SECRET=a9F3kL2P7mXQ8Z4T6R0JwE5sHnD1C
SESSION_EXPIRY_HOURS=8

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# AUTHENTICATION
# ============================================
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_HOST=0.0.0.0

# SSO Configuration (Adjust for your SSO provider)
SSO_PROVIDER=internal
SSO_ISSUER=https://sso.internal.company
SSO_CLIENT_ID=devops-control-center
SSO_CLIENT_SECRET=your_sso_client_secret
SSO_CALLBACK_URL=http://localhost:8000/auth/callback
SSO_JWKS_URI=https://sso.internal.company/.well-known/jwks.json

# JWT
JWT_SECRET=7CwKZ0H8R2aM3JX9P5D6sN4TQF1mLkEYeVBrWUpAghxj
JWT_EXPIRY=8h

# ============================================
# BACKEND SERVICES
# ============================================

# Azure DevOps Service
AZURE_DEVOPS_SERVICE_PORT=8002
AZURE_DEVOPS_SERVICE_HOST=0.0.0.0
USE_MOCK_AZURE_DEVOPS=true
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PAT=your_personal_access_token
AZURE_DEVOPS_API_URL=https://dev.azure.com/${AZURE_DEVOPS_ORG}

# SonarQube Service
SONARQUBE_SERVICE_PORT=8003
SONARQUBE_SERVICE_HOST=0.0.0.0
USE_MOCK_SONARQUBE=true
SONARQUBE_URL=https://sonarqube.internal.company
SONARQUBE_TOKEN=your_sonarqube_token

# Artifactory Service
ARTIFACTORY_SERVICE_PORT=8004
ARTIFACTORY_SERVICE_HOST=0.0.0.0
USE_MOCK_ARTIFACTORY=true
ARTIFACTORY_URL=https://artifactory.internal.company
ARTIFACTORY_API_KEY=your_artifactory_api_key
ARTIFACTORY_USERNAME=your_username

# ServiceNow Service
SERVICENOW_SERVICE_PORT=8005
SERVICENOW_SERVICE_HOST=0.0.0.0
USE_MOCK_SERVICENOW=true
SERVICENOW_INSTANCE=your-instance
SERVICENOW_URL=https://${SERVICENOW_INSTANCE}.service-now.com
SERVICENOW_CLIENT_ID=your_client_id
SERVICENOW_CLIENT_SECRET=your_client_secret
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password

# AI Chatbot Service
AI_CHATBOT_SERVICE_PORT=8006
AI_CHATBOT_SERVICE_HOST=0.0.0.0
USE_MOCK_AI_CHATBOT=true
AI_CHATBOT_API_URL=https://ai.internal.company/api
AI_CHATBOT_UI_URL=https://ai.internal.company
AI_CHATBOT_TOKEN=your_ai_token

# Approval Service
APPROVAL_SERVICE_PORT=8007
APPROVAL_SERVICE_HOST=0.0.0.0

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_APPROVALS=true
ENABLE_OBSERVABILITY=true
ENABLE_USAGE_METRICS=true
ENABLE_AUDIT_LOGGING=true

# ============================================
# EXTERNAL SYSTEM REDIRECTS
# ============================================
SERVICENOW_TICKET_URL=https://your-instance.service-now.com/nav_to.do?uri=incident.do?sys_id=-1
OPENSHIFT_CONSOLE_URL=https://openshift.internal.company
ARTIFACTORY_WEB_URL=https://artifactory.internal.company

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DevOps Control Center
NEXT_PUBLIC_COMPANY_NAME=Your Company
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false

# ============================================
# VAULT (for production)
# ============================================
VAULT_ADDR=https://vault.internal.company
VAULT_TOKEN=your_vault_token
VAULT_PATH=secret/devops-control-center
USE_VAULT=false

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENDPOINT=http://prometheus:9090

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# DEVELOPMENT
# ============================================
# Set to true to bypass authentication in local dev
DEV_MODE_BYPASS_AUTH=false
DEV_MODE_DEFAULT_USER=admin@internal

