# Environment Configuration Template  
# Copy this to .env and update with your values
#
# ARCHITECTURE NOTE:
#   - Frontend: Next.js running on PORT 3000 (TypeScript/React)
#   - Backend: FastAPI + Uvicorn on PORT 8000 (Python 3.11)
#   - Database: PostgreSQL 16
#   - Cache: Redis 7
#
# All external systems (Azure DevOps, SonarQube, etc.) integrated
# via FastAPI API endpoints (backend/python_backend/app/api/*.py)

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devops_control_center
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_secure_password

# Used by Python backend to connect
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# REDIS (Cache & Sessions)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# ============================================
# API GATEWAY (FastAPI Backend)
# ============================================
API_GATEWAY_PORT=8000

# JWT tokens
JWT_SECRET=7CwKZ0H8R2aM3JX9P5D6sN4TQF1mLkEYeVBrWUpAghxj
JWT_EXPIRY=8h

# ============================================
# UI / FRONTEND
# ============================================
# The HTMX-based UI is served directly from the FastAPI backend at /ui/.
# No separate frontend service is required.

# ============================================
# AUTHENTICATION & SSO
# ============================================
# Auth provider (internal, azure-ad, okta, etc.)
AUTH_PROVIDER=internal
SSO_ISSUER=https://sso.internal.company
SSO_CLIENT_ID=devops-control-center
SSO_CLIENT_SECRET=your_sso_client_secret
SSO_CALLBACK_URL=http://localhost:8000/auth/callback
SSO_JWKS_URI=https://sso.internal.company/.well-known/jwks.json

# Development mode: Bypass authentication for local testing
# WARNING: NEVER set to true in production!
DEV_MODE_BYPASS_AUTH=false
DEV_MODE_DEFAULT_USER=admin@internal

# ============================================
# AZURE DEVOPS INTEGRATION (Self-Service Projects)
# ============================================
# Set to 'false' for production to call real Azure DevOps API
USE_MOCK_AZURE_DEVOPS=true

# Azure DevOps base URL
AZURE_DEVOPS_API_URL=https://dev.azure.com

# Personal Access Token (required for real API mode)
# Scopes needed: Project & Team (Read/Write), Process Template, Build (Read)
AZURE_DEVOPS_PAT=your_personal_access_token_here

# Optional: Test user for WIQL queries in local dev
# If set, all work item queries will use this user instead of current user
AZURE_DEVOPS_QUERY_USER=

# ============================================
# SONARQUBE INTEGRATION
# ============================================
USE_MOCK_SONARQUBE=true
SONARQUBE_URL=https://sonarqube.internal.company
SONARQUBE_TOKEN=your_sonarqube_token

# ============================================
# ARTIFACTORY INTEGRATION
# ============================================
USE_MOCK_ARTIFACTORY=true
ARTIFACTORY_URL=https://artifactory.internal.company
ARTIFACTORY_API_KEY=your_artifactory_api_key

# ============================================
# SERVICENOW INTEGRATION
# ============================================
USE_MOCK_SERVICENOW=true
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=your_client_id
SERVICENOW_CLIENT_SECRET=your_client_secret

# ============================================
# AI CHATBOT INTEGRATION
# ============================================
USE_MOCK_AI_CHATBOT=true
AI_CHATBOT_API_URL=https://ai.internal.company/api
AI_CHATBOT_TOKEN=your_ai_token

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SELF_SERVICE=true
ENABLE_APPROVALS=true
ENABLE_OBSERVABILITY=true
ENABLE_AUDIT_LOGGING=true

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# VAULT (Production Secret Management)
# ============================================
USE_VAULT=false
VAULT_ADDR=https://vault.internal.company
VAULT_TOKEN=your_vault_token
VAULT_PATH=secret/devops-control-center

