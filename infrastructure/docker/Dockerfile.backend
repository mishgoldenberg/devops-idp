# Multi-stage build for Node.js backend services
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
WORKDIR /app

# Copy shared library
COPY backend/shared/package*.json ./shared/
RUN cd shared && npm install

# Copy service package files
ARG SERVICE_PATH
COPY ${SERVICE_PATH}/package*.json ./service/
RUN cd service && npm install

# Build stage
FROM base AS builder
WORKDIR /app

# Copy shared library
COPY backend/shared ./shared
COPY --from=deps /app/shared/node_modules ./shared/node_modules
WORKDIR /app/shared
RUN npm run build

# Copy service files
WORKDIR /app
ARG SERVICE_PATH
COPY ${SERVICE_PATH} ./service
COPY --from=deps /app/service/node_modules ./service/node_modules

# Link shared library into service node_modules
RUN rm -rf ./service/node_modules/@devops-control-center/shared && \
    mkdir -p ./service/node_modules/@devops-control-center && \
    cp -r ./shared ./service/node_modules/@devops-control-center/

# Build service
WORKDIR /app/service
RUN npm run build

# Production stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

# Copy built application
COPY --from=builder --chown=appuser:nodejs /app/service/dist ./dist
COPY --from=builder --chown=appuser:nodejs /app/service/node_modules ./node_modules
COPY --from=builder --chown=appuser:nodejs /app/service/package*.json ./

USER appuser

EXPOSE 8000

CMD ["node", "dist/index.js"]

