# ──────────────────────────────────────────────────────────────────────────────
# DevOps Control Center — backend environment example
# Copy to `.env` and fill in real values. Never commit .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Set to "true" to simulate self-service success without touching Azure DevOps,
# ServiceNow, or Kubernetes. Admins can also flip this at runtime from the
# Platform Managing page.
SAFE_MODE=false

# Logging verbosity for the Python app (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devops_portal
POSTGRES_USER=devops
POSTGRES_PASSWORD=

# ── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ── Authentication / OIDC ────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# OIDC / OAuth provider (optional; used if you enable SSO login).
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

# ── Azure DevOps ─────────────────────────────────────────────────────────────
# Keep USE_MOCK_AZURE_DEVOPS=true until the below are populated.
USE_MOCK_AZURE_DEVOPS=true
AZURE_DEVOPS_ORGANIZATION=
# Optional override (only if ORG is not set):
# AZURE_DEVOPS_API_URL=https://dev.azure.com
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ADMIN_PAT=
AZURE_DEVOPS_QUERY_USER=

# ── ServiceNow ───────────────────────────────────────────────────────────────
USE_MOCK_SERVICENOW=true
SNOW_BASE_URL=
SNOW_API_USERNAME=
SNOW_API_PASSWORD=

# ── SonarQube (currently mock-only) ──────────────────────────────────────────
SONARQUBE_URL=
SONARQUBE_TOKEN=

# ── Artifactory (currently mock-only) ────────────────────────────────────────
ARTIFACTORY_URL=
ARTIFACTORY_TOKEN=

# ── Terraform runner (Kubernetes) ────────────────────────────────────────────
# Path to kubeconfig for the cluster that runs Terraform jobs. Leave blank
# when running inside the cluster (service-account auth is auto-detected).
KUBECONFIG=
# Namespace where Terraform Jobs / ConfigMaps are created.
K8S_NAMESPACE=devops-portal
# Hard wall-clock limit per Terraform Job (seconds). Jobs exceeding this are
# terminated by Kubernetes and marked FAILED in the portal.
TERRAFORM_JOB_TIMEOUT_SECONDS=1200

# ── Google Cloud Storage (Terraform state + logs) ────────────────────────────
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Observability / metrics ──────────────────────────────────────────────────
# Optional OTLP endpoint for traces/metrics. Leave blank to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the SPA / templates.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
