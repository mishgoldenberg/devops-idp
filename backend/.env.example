# Backend environment example. Copy to .env and fill in real values.

# Admin
HUB_ADMIN_USERNAME=
HUB_ADMIN_PASSWORD=

# Auth
JWT_SECRET=

# Azure DevOps
AZURE_DEVOPS_BASE_URL=
AZURE_DEVOPS_ADMIN_PAT=

# ServiceNow
SNOW_BASE_URL=
SNOW_API_USERNAME=
SNOW_API_PASSWORD=

# Artifactory
ARTIFACTORY_BASE_URL=

# SonarQube
SONARQUBE_BASE_URL=

# Confluence
CONFLUENCE_BASE_URL=

# DevBot chat assistant (OpenAI-compatible /v1/chat/completions endpoint).
# Helm sets LLM_BASE_URL + LLM_MODEL from the infra-config ConfigMap and
# LLM_API_KEY from the all-secrets Secret. Defaults point at OpenAI; override
# in deployment/values.yaml -> global.llm.* to use a different gateway.
# When LLM_API_KEY is empty the chat feature loads but replies with a
# "not configured" message instead of hitting an LLM.
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
